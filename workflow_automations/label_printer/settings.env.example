# Label Printer settings
# This file stays on YOUR computer next to LabelPrinter.exe - it is never
# sent anywhere except to monday.com and the lab printer.

# Paste your own personal monday.com API token here (see SETUP.txt for how
# to get one). Do not share this token or put it in a shared/synced folder.
MONDAY_API_TOKEN=

# Printer's network address. Only change this if the printer's IP changes
# (ask whoever manages the lab network, or check the printer's own menu).
PRINTER_IP=192.168.68.200

# The rest of these describe the monday.com board and usually don't need to
# change. Leave them as-is unless told otherwise.
BOARD_ID=1847896576
GROUP_ID=topics
NUMBER_COLUMN_ID=numeric_mknnwms1
ADD_SAMPLES_COLUMN_ID=dropdown_mkp0kky2
DATE_COLUMN_ID=date4
BRINE_COLUMN_ID=lookup_mm5zjdyk
PRINTER_MODEL=QL-820NWB
LABEL_SIZE=62
